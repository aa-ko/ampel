# Environment for co2ampel.service — install as /etc/default/co2ampel (mode 0640,
# it may hold a broker password). Every variable maps to a `co2ampel` flag.
CO2AMPEL_HOST=localhost
CO2AMPEL_PORT=1883
CO2AMPEL_TOPIC=buero-nord/co2sensor/co2
# Availability topic of the sensor: "offline" turns the light off at once,
# without waiting for CO2AMPEL_STALE_SECS. Leave unset if the sensor has none.
CO2AMPEL_STATUS_TOPIC=buero-nord/co2sensor/status
#CO2AMPEL_USERNAME=
#CO2AMPEL_PASSWORD=

# Colour thresholds and the timeout that turns the light off after the sensor
# goes quiet. Defaults shown.
#CO2AMPEL_WARN_PPM=900
#CO2AMPEL_ALARM_PPM=1200
#CO2AMPEL_STALE_SECS=300
